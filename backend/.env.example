# ─── Obligatoire ───────────────────────────────────────────────────────────
# PostgreSQL. Par défaut : la base Docker (`npm run db:up` à la racine du repo).
# Production : Neon (https://neon.tech) ou tout PostgreSQL 14+.
DATABASE_URL="postgresql://trackmyapps:trackmyapps@localhost:5432/trackmyapps"

# Secret de signature des sessions : une longue chaîne aléatoire
# (`npm run setup` en génère un ; sinon : openssl rand -hex 32)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# URL(s) du frontend, séparées par des virgules : seules origines autorisées à
# appeler l'API avec la session (CORS) ; la première sert aux liens des emails.
# localhost:5173 est toujours autorisé hors production.
FRONTEND_URL="http://localhost:5173"

PORT=5000
NODE_ENV=development

# ─── Fonctionnalités optionnelles ─────────────────────────────────────────
# Simulateur d'entretien IA (Google Gemini) : chaque utilisateur enregistre sa
# propre clé dans Paramètres > Intelligence artificielle. Les clés sont chiffrées
# en base (AES-256-GCM) avec ENCRYPTION_KEY : 32 octets aléatoires en base64
# (`npm run setup` en génère une ; sinon : openssl rand -base64 32). La changer
# rend les clés déjà enregistrées illisibles (les utilisateurs devront les ressaisir).
ENCRYPTION_KEY="change-me"
# GEMINI_MODEL="gemini-2.5-flash"

# Emails (vérification, mot de passe oublié, rappels). Gmail par défaut :
# EMAIL_PASSWORD est alors un mot de passe d'application. Sans eux, les liens
# sont affichés dans les logs en développement.
EMAIL_USER=
EMAIL_PASSWORD=
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465

# Protège GET /api/cron/reminders (Vercel Cron l'envoie en Bearer token)
CRON_SECRET=

# Compte de démonstration partagé (paramètres en lecture seule, données
# réinitialisées par le cron quotidien). `npm run db:seed` le crée.
DEMO_USER_EMAIL="demo@example.com"
DEMO_USER_PASSWORD="Demo1234!"

# ─── Stockage des documents ────────────────────────────────────────────────
# Store Vercel Blob privé en production ; dossier local si les deux sont vides.
# Connecter le store au projet Vercel crée BLOB_STORE_ID (authentification OIDC
# automatique) ; hors Vercel, utiliser un BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# UPLOAD_DIR="./uploads"
# MAX_FILE_SIZE=5242880
