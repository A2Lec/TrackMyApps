# URL de l'API. Vide en développement : Vite redirige /api vers localhost:5000.
# Production : l'URL du backend, ex. https://votre-api.vercel.app/api
VITE_API_URL=

# Affiche le bouton « compte démo » sur la page de connexion (cf. DEMO_USER_* côté backend)
VITE_DEMO_EMAIL="demo@example.com"
VITE_DEMO_PASSWORD="Demo1234!"

# Éditeur affiché dans les pages légales (mentions légales, CGU, confidentialité)
VITE_SITE_URL="http://localhost:5173"
VITE_LEGAL_OWNER_NAME=
VITE_LEGAL_CONTACT_EMAIL=
